DB_PASSWORD=local-lutiano
DB_ROOT_PASSWORD=local-root
S3_ACCESS_KEY=lutiano
S3_SECRET_KEY=local-storage-secret
# Host ports (change if 3306/6379/9000 are already in use on your machine; S3_PORT is image storage)
DB_PORT=3306
REDIS_PORT=6379
S3_PORT=9000
# API: JWT signing secret (32+ characters; required outside local development)
LUTIANO_JWT_SECRET=change-me-to-a-long-random-string-0123456789
LUTIANO_CORS_ORIGINS=http://localhost:5173

# ---- Infrastructure containers (docker compose reads these) ----
ES_PORT=9200
KIBANA_PORT=5601
ELASTIC_PASSWORD=change-me
ES_APP_PASSWORD=change-me
KIBANA_SYSTEM_PASSWORD=change-me
KIBANA_ENCRYPTION_KEY=change-me-at-least-32-characters-long

# ---- API connections (the API reads real environment variables, not this file:
#      load them with `set -a; source .env; set +a` before ./gradlew bootRun) ----
SERVER_PORT=8080
# Health probes, metrics and build info are served on this separate port (never publish it publicly)
MANAGEMENT_PORT=8081
DB_URL=jdbc:mariadb://localhost:3306/lutiano
DB_USER=lutiano
REDIS_HOST=localhost
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=products
S3_DOCUMENTS_BUCKET=seller-documents
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=lutiano_app
ELASTICSEARCH_PASSWORD=change-me
SEARCH_INDEXING_ENABLED=true

# ---- API security and behaviour ----
LUTIANO_JWT_TTL_HOURS=8
LUTIANO_MFA_ENABLED=true
LUTIANO_FIREBASE_CREDENTIALS=secrets/firebase-service-account.json

# ---- SMS (dev mode writes codes to the log; the dev code only works in dev mode) ----
LUTIANO_SMS_MODE=dev
LUTIANO_OTP_DEV_CODE=123456
HOMBEE_SMS_BASE_URL=https://api.hombee.com
HOMBEE_SMS_API_KEY=
HOMBEE_SMS_SENDER_ID=LUTIANO

# ---- Customer sign-in with Google / Apple (empty = switched off) ----
LUTIANO_GOOGLE_CLIENT_IDS=
LUTIANO_APPLE_AUDIENCES=

# ---- Business rules ----
LUTIANO_SELLER_REQUIRED_DOCUMENTS=NATIONAL_ID,CONTRACT
LUTIANO_SELLER_ENFORCE_ELIGIBILITY=false
LUTIANO_REFUNDS_SECOND_APPROVER=true
LUTIANO_ORDERS_ACCEPT_TIMEOUT_MINUTES=30
LUTIANO_REWARDS_WALLET_VALIDITY_DAYS=30
