# Copy to .env (git-ignored) and change every password outside local development.

# Existing services
DB_PASSWORD=local-lutiano
DB_ROOT_PASSWORD=local-root
DB_PORT=3306
REDIS_PORT=6379
S3_ACCESS_KEY=lutiano
S3_SECRET_KEY=local-storage-secret
S3_PORT=9000

# Search (Elasticsearch + Kibana). Both ports are bound to localhost only.
ES_PORT=9200
KIBANA_PORT=5601
ELASTIC_PASSWORD=local-elastic
KIBANA_SYSTEM_PASSWORD=local-kibana-system
ES_APP_PASSWORD=local-search-app
KIBANA_ENCRYPTION_KEY=local-kibana-encryption-key-0123456789

# Backend search settings (read by the API; see application.yml). The API signs in as lutiano_app, never as elastic.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=lutiano_app
ELASTICSEARCH_PASSWORD=local-search-app
ELASTICSEARCH_CONNECT_TIMEOUT_MS=3000
ELASTICSEARCH_SOCKET_TIMEOUT_MS=10000
SEARCH_INDEXING_ENABLED=true
SEARCH_BATCH_SIZE=200
SEARCH_RETRY_MAX_ATTEMPTS=6
